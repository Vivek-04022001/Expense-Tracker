generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  food_and_drink
  transport
  bills_and_utilities
  shopping
  health
  entertainment
  education
  other
}

enum IncomeType {
  salary
  freelance
  investment
  reward
  other
}

enum PaymentMethod {
  upi
  bank_transfer
  cash
  other
}

enum AccountType {
  card
  cash
  wallet
  bank
  savings
  investment
  other
}

enum CategoryKind {
  expense
  income
}

model User {
  id           String                @id @default(uuid())
  name         String
  phone        String                @unique
  passwordHash String
  expenses     Expense[]
  incomes      Income[]
  budgets      Budget[]
  accounts     Account[]
  transfers    Transfer[]
  categories   TransactionCategory[]
  refreshToken RefreshToken[]
  createdAt    DateTime              @default(now())
}

model TransactionCategory {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  name      String
  kind      CategoryKind
  icon      String
  color     String
  // Stable identifier for seeded built-ins (e.g. "food_and_drink"); null for custom.
  key       String?
  isSystem  Boolean      @default(false)
  sortOrder Int          @default(0)
  expenses  Expense[]
  incomes   Income[]
  budgets   Budget[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([userId, updatedAt])
}

model Account {
  id             String      @id @default(uuid())
  name           String
  type           AccountType @default(other)
  // User-entered starting balance. `balance` below is derived from openingBalance
  // plus all (non-deleted) income/expense/transfer activity — see recomputeBalance().
  openingBalance Decimal     @default(0)
  balance        Decimal     @default(0)
  color          String?
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  expenses       Expense[]
  incomes        Income[]
  transfersFrom  Transfer[]  @relation("TransferFrom")
  transfersTo    Transfer[]  @relation("TransferTo")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  @@index([userId])
  @@index([userId, updatedAt])
}

model Expense {
  id            String               @id @default(uuid())
  amount        Decimal
  category      Category             @default(other)
  paymentMethod PaymentMethod        @default(other)
  description   String?
  userId        String
  user          User                 @relation(fields: [userId], references: [id])
  accountId     String?
  account       Account?             @relation(fields: [accountId], references: [id])
  categoryId    String?
  categoryRef   TransactionCategory? @relation(fields: [categoryId], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?

  @@index([accountId])
  @@index([categoryId])
  @@index([userId, updatedAt])
}

model Income {
  id          String               @id @default(uuid())
  amount      Decimal
  incomeType  IncomeType           @default(other)
  description String?
  userId      String
  user        User                 @relation(fields: [userId], references: [id])
  accountId   String?
  account     Account?             @relation(fields: [accountId], references: [id])
  categoryId  String?
  categoryRef TransactionCategory? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?

  @@index([accountId])
  @@index([categoryId])
  @@index([userId, updatedAt])
}

model Transfer {
  id            String    @id @default(uuid())
  amount        Decimal
  description   String?
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  fromAccountId String
  fromAccount   Account   @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccountId   String
  toAccount     Account   @relation("TransferTo", fields: [toAccountId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([userId])
  @@index([userId, updatedAt])
}

model Budget {
  id          String               @id @default(uuid())
  limitAmount Decimal
  category    Category
  categoryId  String?
  categoryRef TransactionCategory? @relation(fields: [categoryId], references: [id])
  month       Int
  year        Int
  userId      String
  user        User                 @relation(fields: [userId], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?

  @@unique([userId, category, month, year])
  @@index([categoryId])
  @@index([userId, updatedAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  isRevoked Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  expiredAt DateTime
}
